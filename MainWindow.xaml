<Window x:Class="ConnectionChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ConnectionChecker.Models"
        Title="PULSE//WATCH"
        Width="980" Height="640"
        MinWidth="760" MinHeight="480"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Status dot color by StatusDisplay -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="{StaticResource TextDimBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusDisplay}" Value="ONLINE">
                    <Setter Property="Fill" Value="{StaticResource OnlineBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#22E584" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusDisplay}" Value="OFFLINE">
                    <Setter Property="Fill" Value="{StaticResource OfflineBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF3B5C" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusDisplay}" Value="ONLINE">
                    <Setter Property="Foreground" Value="{StaticResource OnlineBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusDisplay}" Value="OFFLINE">
                    <Setter Property="Foreground" Value="{StaticResource OfflineBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HostRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="16,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding StatusDisplay}" Value="PAUSED">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A4E7E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelLightBrush}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="16" ShadowDepth="0" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Group tab: dim name, accent with a glowing underline when selected. -->
        <Style x:Key="GroupTabItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AllowDrop" Value="True"/>
            <EventSetter Event="DragOver" Handler="Tab_DragOver"/>
            <EventSetter Event="DragLeave" Handler="Tab_DragLeave"/>
            <EventSetter Event="Drop" Handler="Tab_Drop"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="bd" Background="Transparent" CornerRadius="3,3,0,0" Padding="14,8,14,9">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="underline" Height="2" VerticalAlignment="Bottom" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#0AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#0F00E5FF"/>
                                <Setter TargetName="underline" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="underline" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#2200E5FF"/>
                                <Setter TargetName="underline" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless "+" after the last tab. -->
        <Style x:Key="TabAddButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="10,3" Margin="4,0,0,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#1400E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3300E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Excel-style arrows that step through the tabs when they don't all fit. -->
        <Style x:Key="TabArrow" TargetType="RepeatButton" BasedOn="{StaticResource SpinButton}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Interval" Value="150"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Consolas" FontSize="20" FontWeight="Bold">
                        <Run Text="PULSE" Foreground="{StaticResource AccentBrush}"/><Run Text="//" Foreground="{StaticResource TextDimBrush}"/><Run Text="WATCH" Foreground="{StaticResource TextBrush}"/>
                    </TextBlock>
                    <TextBlock Text="CONNECTION MONITOR" Foreground="{StaticResource TextDimBrush}"
                               FontSize="10" FontWeight="SemiBold" Margin="16,0,0,0"
                               VerticalAlignment="Center" >
                        <TextBlock.LayoutTransform>
                            <ScaleTransform/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="HISTORY" Style="{StaticResource NeonButton}"
                            ToolTip="When targets went offline and came back, since the app started"
                            Click="History_Click"/>
                    <Button Content="⚙ SETTINGS" Style="{StaticResource NeonButton}" Margin="10,0,0,0"
                            Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Group tabs ===== -->
        <Grid Grid.Row="1" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                    Background="{StaticResource BorderBrush}"/>

            <!-- Only shown while the tabs don't all fit. -->
            <StackPanel x:Name="TabArrows" Orientation="Horizontal" Margin="0,0,6,1" Visibility="Collapsed">
                <RepeatButton x:Name="TabsLeftButton" Style="{StaticResource TabArrow}"
                              Content="M4,0 L0,4 L4,8" Click="TabsLeft_Click" ToolTip="Scroll the tabs left"/>
                <RepeatButton x:Name="TabsRightButton" Style="{StaticResource TabArrow}"
                              Content="M0,0 L4,4 L0,8" Click="TabsRight_Click" ToolTip="Scroll the tabs right"/>
            </StackPanel>

            <!-- "+" follows the last tab, and stays pinned at the edge once the tabs overflow. -->
            <DockPanel Grid.Column="1" HorizontalAlignment="Left">
                <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource TabAddButton}"
                        ToolTip="New group" Click="AddGroup_Click"/>
                <ScrollViewer x:Name="TabScroller" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              ScrollChanged="TabScroller_ScrollChanged"
                              PreviewMouseWheel="TabScroller_PreviewMouseWheel">
                    <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource GroupTabItem}"
                             IsTextSearchEnabled="False"
                             SelectionChanged="TabList_SelectionChanged"
                             MouseDoubleClick="TabList_MouseDoubleClick"
                             KeyDown="TabList_KeyDown">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter/>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Background="Transparent"
                                            ToolTip="{Binding Summary}"
                                            ContextMenuService.IsEnabled="{Binding CanEdit}">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu Style="{StaticResource NeonMenu}">
                                            <MenuItem Header="Rename" Click="RenameGroup_Click"/>
                                            <MenuItem Header="Move left" Click="MoveGroupLeft_Click"
                                                      IsEnabled="{Binding CanMoveLeft}"/>
                                            <MenuItem Header="Move right" Click="MoveGroupRight_Click"
                                                      IsEnabled="{Binding CanMoveRight}"/>
                                            <Separator/>
                                            <MenuItem Header="Delete group" Click="DeleteGroup_Click"
                                                      Foreground="{StaticResource OfflineBrush}"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>

                                    <!-- Something in this group is down. -->
                                    <Ellipse Width="7" Height="7" Margin="0,1,7,0" VerticalAlignment="Center"
                                             Fill="{StaticResource OfflineBrush}"
                                             Visibility="{Binding HasOffline, Converter={StaticResource BoolToVis}}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#FF3B5C" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Style="{StaticResource NeonTextBox}" FontSize="12.5" FontWeight="SemiBold"
                                                 Padding="2,0" Margin="-4,-3" MinWidth="110"
                                                 MaxLength="{x:Static models:HostGroup.MaxNameLength}"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                 IsVisibleChanged="RenameBox_IsVisibleChanged"
                                                 KeyDown="RenameBox_KeyDown"
                                                 LostKeyboardFocus="RenameBox_LostKeyboardFocus"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Count}" FontFamily="Consolas" FontSize="11"
                                               Margin="8,1,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- ===== Host list ===== -->
        <Grid Grid.Row="2" Margin="24,12,24,0">
            <ListBox x:Name="HostList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource HostRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="HostList_MouseDoubleClick"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="HostList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="HostList_PreviewMouseMove"
                     Drop="HostList_Drop">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:HostEntry}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Style="{StaticResource StatusDot}" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Address}" Foreground="{StaticResource TextDimBrush}"
                                       FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                            <TextBlock Grid.Column="3" Text="{Binding ModeDisplay}" Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="4" Text="{Binding LatencyDisplay}"
                                       FontFamily="Consolas" FontSize="12" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusDisplay}" Value="OFFLINE">
                                                <Setter Property="Foreground" Value="{StaticResource OfflineBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="5" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDimBrush}"
                                       FontFamily="Consolas" FontSize="11">
                                <Run Text="{Binding LastCheckedDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IntervalSeconds}"/><Run Text="s"/>
                            </TextBlock>

                            <TextBlock Grid.Column="6" Text="{Binding StatusDisplay}" Style="{StaticResource StatusText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" Text="NO TARGETS CONFIGURED" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Consolas" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyHint" Text="Add a host or IP below to begin monitoring."
                           Foreground="{StaticResource TextDimBrush}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.7"/>
            </StackPanel>
        </Grid>

        <!-- ===== Footer actions ===== -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="+ ADD TARGET" Style="{StaticResource NeonButton}" Click="Add_Click"/>
                    <Button x:Name="EditButton" Content="EDIT" Style="{StaticResource NeonButton}"
                            Margin="10,0,0,0" Click="Edit_Click" IsEnabled="False"/>
                    <Button x:Name="RemoveButton" Content="REMOVE" Style="{StaticResource DangerButton}"
                            Margin="10,0,0,0" Click="Remove_Click" IsEnabled="False"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" FontWeight="SemiBold">
                    <Hyperlink Foreground="{StaticResource TextDimBrush}"
                               TextDecorations="{x:Null}"
                               Click="ConfigFolder_Click">
                        <Hyperlink.Style>
                            <Style TargetType="Hyperlink">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Hyperlink.Style>
                        <Run Text="⌁ CONFIG FOLDER"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
